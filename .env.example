# Django
SECRET_KEY=change-me
DEBUG=True

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/research

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "openai" or "anthropic". Only the active provider's API key is required.
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=12
MAX_INPUT_TOKENS=40000

# ─── Storage ───────────────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media
